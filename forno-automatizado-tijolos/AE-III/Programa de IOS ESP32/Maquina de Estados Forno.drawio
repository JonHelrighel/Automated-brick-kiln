        </mxCell>
        <mxCell id="OIvkDWpg9fBdokE33RzL-358" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="// ================================================&lt;br&gt;//&amp;nbsp; MÁQUINA DE ESTADOS - Forno&amp;nbsp;&lt;br&gt;// ================================================&lt;br&gt;&lt;br&gt;&lt;br&gt;enum Estado {&lt;br&gt;&amp;nbsp; ESTADO_1_DESLIGADO,&lt;br&gt;&amp;nbsp; ESTADO_2_AGUARDANDO_SET_POINT,&lt;br&gt;&amp;nbsp; ESTADO_3_MAQUINA_LIGADA,&lt;br&gt;&amp;nbsp; ESTADO_4_PORTAS_ABERTAS,&lt;br&gt;&amp;nbsp; ESTADO_5_FORNO_CARREGADO,&lt;br&gt;&amp;nbsp; ESTADO_6_LIGA_TEMPERATURA_E_PROCESSO,&lt;br&gt;&amp;nbsp; ESTADO_7_DESCARREGAMENTO,&lt;br&gt;&amp;nbsp; ESTADO_8_ESTADO_DE_PORTA_ABERTA,&lt;br&gt;&amp;nbsp; ESTADO_9_FECHAMENTO_DE_PORTA&lt;br&gt;};&lt;br&gt;&lt;br&gt;&lt;br&gt;Estado estadoAtual = ESTADO_1_DESLIGADO;&lt;br&gt;&lt;br&gt;&lt;br&gt;// ================================================&lt;br&gt;//&amp;nbsp; SETUP&lt;br&gt;// ================================================&lt;br&gt;void setup() {&lt;br&gt;&amp;nbsp; //Declara os pinos no futuro (inputs e outputs)&lt;br&gt;&amp;nbsp; // pinMode(botaoLigar, INPUT);&lt;br&gt;&amp;nbsp; // pinMode(sensorPorta, INPUT);&lt;br&gt;&amp;nbsp; // etc.&lt;br&gt;}&lt;br&gt;&lt;br&gt;&lt;br&gt;// ================================================&lt;br&gt;//&amp;nbsp; LOOP PRINCIPAL - Máquina de Estados&lt;br&gt;// ================================================&lt;br&gt;void loop() {&lt;br&gt;&lt;br&gt;&lt;br&gt;&amp;nbsp; switch (estadoAtual) {&lt;br&gt;&lt;br&gt;&lt;br&gt;&amp;nbsp; &amp;nbsp; case ESTADO_1_DESLIGADO:&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; // Máquina Desligada&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; // Condições de saída:&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; // - Botão Ligar pressionado&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; if (/* botãoLigar pressionado */) {&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; estadoAtual = ESTADO_2_AGUARDANDO_SET_POINT;&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; }&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; break;&lt;br&gt;&lt;br&gt;&lt;br&gt;&amp;nbsp; &amp;nbsp; case ESTADO_2_AGUARDANDO_SET_POINT:&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; // Aguardando Set Point&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; // Ações típicas: receber Set_Point via serial ou HMI&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; if (/* Set_Point recebido */) {&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; // Estado 3 - Máquina Ligada&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; estadoAtual = ESTADO_3_MAQUINA_LIGADA;&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; }&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; break;&lt;br&gt;&lt;br&gt;&lt;br&gt;&amp;nbsp; &amp;nbsp; case ESTADO_3_MAQUINA_LIGADA:&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; // Máquina Ligada&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; if (/* Botão Iniciar pressionado */) {&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; estadoAtual = ESTADO_4_PORTAS_ABERTAS;&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; }&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; break;&lt;br&gt;&lt;br&gt;&lt;br&gt;&amp;nbsp; &amp;nbsp; case ESTADO_4_PORTAS_ABERTAS:&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; // Portas Abertas&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; // Ações: Abre portas&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; if (/* carrinho dentro do forno */) {&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; estadoAtual = ESTADO_5_FORNO_CARREGADO;&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; }&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; break;&lt;br&gt;&lt;br&gt;&lt;br&gt;&amp;nbsp; &amp;nbsp; case ESTADO_5_FORNO_CARREGADO:&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; // Forno Carregado&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; if (/* Sensor Porta Fechada */) {&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; estadoAtual = ESTADO_6_LIGA_TEMPERATURA_E_PROCESSO;&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; }&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; break;&lt;br&gt;&lt;br&gt;&lt;br&gt;&amp;nbsp; &amp;nbsp; case ESTADO_6_LIGA_TEMPERATURA_E_PROCESSO:&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; // Liga a Temperatura e Processo de cozimento&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; // Ações: Ligar controle de temperatura + geração de gráficos&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; if (/* Final do Tempo de Cozimento */) {&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; estadoAtual = ESTADO_7_DESCARREGAMENTO;&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; }&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; break;&lt;br&gt;&lt;br&gt;&lt;br&gt;&amp;nbsp; &amp;nbsp; case ESTADO_7_DESCARREGAMENTO:&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; // Descarregamento&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; // Ações: Desligar resistências, parar gráficos, abrir portas&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; if (/* Porta aberta */) {&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; estadoAtual = ESTADO_8_ESTADO_DE_PORTA_ABERTA;&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; }&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; break;&lt;br&gt;&lt;br&gt;&lt;br&gt;&amp;nbsp; &amp;nbsp; case ESTADO_8_ESTADO_DE_PORTA_ABERTA:&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; // Estado de Porta Aberta (após cozimento)&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; // Ações: Aciona carro de saída&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; if (/* Sensor carro fora */) {&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; estadoAtual = ESTADO_9_FECHAMENTO_DE_PORTA;&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; }&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; break;&lt;br&gt;&lt;br&gt;&lt;br&gt;&amp;nbsp; &amp;nbsp; case ESTADO_9_FECHAMENTO_DE_PORTA:&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; // Fechamento de porta&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; // Ações: Fechar a porta&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; if (/* Porta fechada */) {&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; // Volta para o início ou estado de espera&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; estadoAtual = ESTADO_1_DESLIGADO;&amp;nbsp; &amp;nbsp;// ou ESTADO_2_AGUARDANDO_SET_POINT&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; }&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; break;&lt;br&gt;&lt;br&gt;&lt;br&gt;&amp;nbsp; }&lt;br&gt;&lt;br&gt;&lt;br&gt;&amp;nbsp; delay(50);&lt;br&gt;}" vertex="1">
          <mxGeometry height="1883" width="780" x="-850" y="38.5" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
